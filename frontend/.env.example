# MEMETH Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# CONTRACT ADDRESSES (from deployments)
# =============================================================================

# Sepolia (L1 Testnet) - Default for development
NEXT_PUBLIC_CONTRACT_ADDRESS_SEPOLIA=0x...
# After deploying: npx hardhat run scripts/deploy.js --network sepolia
# Copy address from deployments/sepolia.json

# Base Sepolia (L2 Testnet) - Default for development
NEXT_PUBLIC_CONTRACT_ADDRESS_BASE_SEPOLIA=0x...
# After deploying: npx hardhat run scripts/deploy.js --network baseSepolia
# Copy address from deployments/baseSepolia.json

# Ethereum Mainnet (L1) - Production (do NOT deploy yet!)
NEXT_PUBLIC_CONTRACT_ADDRESS_MAINNET=0x...

# Base (L2) - Production (do NOT deploy yet!)
NEXT_PUBLIC_CONTRACT_ADDRESS_BASE=0x...

# Local Hardhat (for development)
NEXT_PUBLIC_CONTRACT_ADDRESS_HARDHAT=0x...

# =============================================================================
# WALLETCONNECT PROJECT ID
# =============================================================================

# Required for RainbowKit wallet connection
# Get one at: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# =============================================================================
# OPTIONAL: ANALYTICS & MONITORING
# =============================================================================

# Google Analytics
NEXT_PUBLIC_GA_ID=

# Sentry (error tracking)
NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# QUICK START GUIDE
# =============================================================================
#
# 1. Copy this file: cp .env.example .env.local
#
# 2. Deploy contracts to testnets:
#    cd ..
#    npx hardhat run scripts/deploy.js --network sepolia
#    npx hardhat run scripts/deploy.js --network baseSepolia
#
# 3. Copy contract addresses from deployments/*.json to this file
#
# 4. Get WalletConnect Project ID:
#    - Visit: https://cloud.walletconnect.com
#    - Create a new project
#    - Copy the Project ID
#
# 5. Start frontend:
#    npm run dev
#
# 6. Connect wallet to Sepolia or Base Sepolia
#
# =============================================================================
# NETWORK ARCHITECTURE
# =============================================================================
#
# MEMETH uses a hybrid L1/L2 architecture:
#
# L1 (Ethereum Mainnet/Sepolia):
#   - Treasury settlement
#   - Final ETH settlements
#   - Higher security, higher gas
#
# L2 (Base/Base Sepolia):
#   - User interactions
#   - Position management
#   - Lower gas costs
#
# =============================================================================
