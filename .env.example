# MEMETH Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Private key for contract deployment (without 0x prefix)
# ⚠️ NEVER commit this to git! Keep it secret!
DEPLOYER_PRIVATE_KEY=your_private_key_here

# =============================================================================
# RPC ENDPOINTS
# =============================================================================

# Ethereum Mainnet (L1 Settlement Layer)
MAINNET_RPC_URL=https://eth.llamarpc.com
# Alternative: https://rpc.ankr.com/eth
# Get your own: https://www.alchemy.com or https://infura.io

# Ethereum Sepolia Testnet (L1 Development)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Alternative: https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# Get testnet ETH: https://sepoliafaucet.com

# Base Mainnet (L2 User Interaction Layer)
BASE_RPC_URL=https://mainnet.base.org
# Alternative: https://base.llamarpc.com

# Base Sepolia Testnet (L2 Development)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# Get testnet ETH: https://bridge.base.org/deposit (bridge from Sepolia)

# =============================================================================
# BLOCK EXPLORERS (for contract verification)
# =============================================================================

# Etherscan API Key (for Ethereum Mainnet + Sepolia)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
# Get one at: https://etherscan.io/apis

# Basescan API Key (for Base + Base Sepolia)
BASESCAN_API_KEY=your_basescan_api_key_here
# Get one at: https://basescan.org/apis

# =============================================================================
# OPTIONAL: GAS REPORTING
# =============================================================================

# Enable gas reporting in tests
REPORT_GAS=false

# =============================================================================
# QUICK START GUIDE
# =============================================================================
#
# 1. Copy this file: cp .env.example .env
# 
# 2. Add your deployer private key (for testnets, use a test wallet!)
#    - Get Sepolia ETH: https://sepoliafaucet.com
#    - Get Base Sepolia ETH: Bridge from Sepolia to Base Sepolia
#
# 3. (Optional) Add your own RPC URLs for better reliability
#
# 4. Deploy to Sepolia:
#    npx hardhat run scripts/deploy.js --network sepolia
#
# 5. Deploy to Base Sepolia:
#    npx hardhat run scripts/deploy.js --network baseSepolia
#
# 6. Update frontend/.env with deployed contract addresses
#
# =============================================================================
