# MEMETH Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Private key for contract deployment (without 0x prefix)
# ⚠️ NEVER commit this to git! Keep it secret!
DEPLOYER_PRIVATE_KEY=your_private_key_here

# =============================================================================
# RPC ENDPOINTS
# =============================================================================

# Base Mainnet (Primary deployment network)
RPC_URL_BASE_MAINNET=https://mainnet.base.org
# Alternative: https://base.llamarpc.com
# Get your own at: https://www.alchemy.com or https://infura.io

# =============================================================================
# BLOCK EXPLORERS (for contract verification)
# =============================================================================

# Basescan API Key (for Base mainnet verification)
BASESCAN_API_KEY=your_basescan_api_key_here
# Get one at: https://basescan.org/apis

# =============================================================================
# OPTIONAL: GAS REPORTING
# =============================================================================

# Enable gas reporting in tests
REPORT_GAS=false

# =============================================================================
# QUICK START GUIDE
# =============================================================================
#
# 1. Copy this file: cp .env.example .env
# 
# 2. Add your deployer private key
#    - For mainnet, use a secure wallet with proper key management
#    - Ensure you have sufficient ETH on Base for deployment
#
# 3. (Optional) Add your own RPC URL for better reliability
#
# 4. Get Basescan API key for contract verification
#
# 5. Deploy to Base mainnet:
#    npm run deploy:baseMainnet
#
# 6. Verify contract on Basescan:
#    npm run verify:baseMainnet
#
# 7. Update frontend/.env with deployed contract addresses
#
# =============================================================================
