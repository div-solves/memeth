{
  "name": "memeth",
  "version": "0.1.0",
  "description": "MEMETH - The ETH-Native Virtual Meme Market. No rugpulls, no scams, only fair exposure.",
  "main": "index.js",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start": "cd frontend && npm start",
    "lint": "eslint . --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "hardhat test",
    "compile:contracts": "hardhat compile",
    "deploy:baseMainnet": "hardhat run scripts/deploy.js --network base",
    "verify:baseMainnet": "hardhat verify --network base",
    "console:baseMainnet": "hardhat console --network base",
    "node": "hardhat node"
  },
  "keywords": [
    "ethereum",
    "meme",
    "web3",
    "defi",
    "virtual-market"
  ],
  "author": "MEMETH Team",
  "license": "MIT",
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "@rainbow-me/rainbowkit": "^2.0.0",
    "@tanstack/react-query": "^5.0.0",
    "dotenv": "^16.3.1",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "viem": "^2.7.0",
    "wagmi": "^2.5.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.50.0",
    "eslint-config-next": "^14.0.0",
    "hardhat": "^2.19.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
